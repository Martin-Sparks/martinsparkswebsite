---
const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/runs', label: 'Run Routes' },
  { href: '/about', label: 'About' },
];

const { pathname } = Astro.url;
---

<header style="background-color: var(--color-bg); border-bottom: 1px solid var(--color-border);">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">

    <a href="/" class="site-logo no-underline">Martin Sparks</a>

    <nav class="flex items-center gap-1">
      {navLinks.map(link => {
        const active = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class="text-sm font-medium px-4 py-2 rounded-full no-underline transition-all"
            style={active
              ? 'background-color: var(--color-accent-light); color: var(--color-accent);'
              : 'color: var(--color-muted);'}
          >
            {link.label}
          </a>
        );
      })}

      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="ml-2 w-9 h-9 flex items-center justify-center rounded-full transition-all cursor-pointer"
        style="background-color: var(--color-bg-subtle); color: var(--color-muted);"
      >
        <span id="theme-icon-light" class="hidden">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
        </span>
        <span id="theme-icon-dark">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-logo {
    font-size: 0.88rem;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-text);
    transition: color 0.2s, text-shadow 0.2s;
  }

  :global(.dark) .site-logo {
    color: var(--color-text-on-dark);
    text-shadow:
      0 0 10px rgba(238, 232, 213, 0.55),
      0 0 25px rgba(238, 232, 213, 0.2);
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const iconLight = document.getElementById('theme-icon-light');
  const iconDark = document.getElementById('theme-icon-dark');

  function applyTheme(dark: boolean) {
    root.classList.toggle('dark', dark);
    iconLight?.classList.toggle('hidden', !dark);
    iconDark?.classList.toggle('hidden', dark);
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  }

  const stored = localStorage.getItem('theme');
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  applyTheme(stored ? stored === 'dark' : prefersDark);

  toggle?.addEventListener('click', () => {
    applyTheme(!root.classList.contains('dark'));
  });

  // Logo scramble animation
  const logo = document.querySelector<HTMLAnchorElement>('.site-logo');
  if (logo) {
    const original = logo.textContent ?? '';
    const pool = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let intervalId: ReturnType<typeof setInterval> | null = null;
    let iteration = 0;

    logo.addEventListener('mouseenter', () => {
      if (intervalId) clearInterval(intervalId);
      iteration = 0;

      intervalId = setInterval(() => {
        logo.textContent = original
          .split('')
          .map((char, i) => {
            if (char === ' ') return ' ';
            if (i < Math.floor(iteration)) return char;
            return pool[Math.floor(Math.random() * pool.length)];
          })
          .join('');

        iteration += 0.5;

        if (iteration >= original.length) {
          clearInterval(intervalId!);
          logo.textContent = original;
        }
      }, 30);
    });
  }
</script>
