---
const year = new Date().getFullYear();

const links = [
  { href: '/blog', label: 'Blog' },
  { href: '/runs', label: 'Run Routes' },
  { href: '/about', label: 'About' },
  { href: '/rss.xml', label: 'RSS' },
];

const social = [
  { href: 'https://linkedin.com/in/martin-sparks', label: 'LinkedIn' },
  { href: 'https://github.com/Martin-Sparks', label: 'GitHub' },
  { href: 'https://www.strava.com/athletes/97483812', label: 'Strava' },
];
---

<!-- Hidden form for Netlify build-time detection -->
<form name="contact" data-netlify="true" netlify-honeypot="bot-field" hidden>
  <input type="text" name="name" />
  <input type="email" name="email" />
  <textarea name="message"></textarea>
  <input type="hidden" name="bot-field" />
</form>

<footer style="background-color: var(--color-bg-dark); color: var(--color-text-on-dark);">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex flex-col sm:flex-row justify-between gap-12 mb-16">

      <!-- Brand -->
      <div class="max-w-xs">
        <p class="text-lg font-bold mb-3" style="color: var(--color-text-on-dark);">Martin Sparks</p>
        <p class="text-sm leading-relaxed" style="color: var(--color-muted-on-dark);">
          Engineering manager, long-distance runner, and builder of things. Based in Scotland.
        </p>
      </div>

      <!-- Nav columns -->
      <div class="flex gap-16">
        <div>
          <p class="eyebrow mb-4" style="color: var(--color-muted-on-dark);">Pages</p>
          <ul class="space-y-2">
            {links.map(l => (
              <li>
                <a
                  href={l.href}
                  class="text-sm no-underline hover:underline"
                  style="color: var(--color-muted-on-dark);"
                >
                  {l.label}
                </a>
              </li>
            ))}
            <li>
              <button
                id="open-contact-modal"
                class="text-sm no-underline hover:underline"
                style="color: var(--color-muted-on-dark); background: none; border: none; padding: 0; cursor: pointer;"
              >
                Contact
              </button>
            </li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4" style="color: var(--color-muted-on-dark);">Find me</p>
          <ul class="space-y-2">
            {social.map(l => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm no-underline hover:underline"
                  style="color: var(--color-muted-on-dark);"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="pt-8" style="border-top: 1px solid var(--color-border-dark);">
      <p class="text-xs" style="color: var(--color-muted-on-dark);">
        &copy; {year} Martin Sparks. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<!-- Contact modal -->
<div
  id="contact-modal"
  style="
    position: fixed; inset: 0; z-index: 1000;
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
    background: rgba(15, 14, 10, 0.8);
    backdrop-filter: blur(6px);
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
  "
>
  <div style="
    background-color: #1A1710;
    border: 1px solid rgba(238,232,213,0.12);
    border-radius: 20px;
    padding: 40px;
    width: 100%;
    max-width: 480px;
    position: relative;
    transform: translateY(16px);
    transition: transform 0.25s ease;
  ">
    <!-- Close button -->
    <button
      id="close-contact-modal"
      aria-label="Close"
      style="
        position: absolute; top: 16px; right: 16px;
        background: none; border: none; cursor: pointer;
        color: var(--color-muted-on-dark); padding: 4px;
        line-height: 1;
      "
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M3 3L15 15M15 3L3 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
    </button>

    <p class="eyebrow mb-3" style="color: var(--color-muted-on-dark);">Get in touch</p>
    <h2 class="text-2xl font-bold mb-6" style="color: var(--color-text-on-dark);">Send me a message</h2>

    <form id="contact-form" class="space-y-4">
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="bot-field" />

      <div>
        <label class="block text-xs font-semibold mb-1.5" style="color: var(--color-muted-on-dark); letter-spacing: 0.05em; text-transform: uppercase;">Name</label>
        <input
          type="text" name="name" required
          class="w-full px-4 py-3 rounded-xl text-sm outline-none"
          style="background-color: rgba(238,232,213,0.07); border: 1px solid rgba(238,232,213,0.12); color: var(--color-text-on-dark);"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1.5" style="color: var(--color-muted-on-dark); letter-spacing: 0.05em; text-transform: uppercase;">Email</label>
        <input
          type="email" name="email" required
          class="w-full px-4 py-3 rounded-xl text-sm outline-none"
          style="background-color: rgba(238,232,213,0.07); border: 1px solid rgba(238,232,213,0.12); color: var(--color-text-on-dark);"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold mb-1.5" style="color: var(--color-muted-on-dark); letter-spacing: 0.05em; text-transform: uppercase;">Message</label>
        <textarea
          name="message" rows="4" required
          class="w-full px-4 py-3 rounded-xl text-sm outline-none resize-none"
          style="background-color: rgba(238,232,213,0.07); border: 1px solid rgba(238,232,213,0.12); color: var(--color-text-on-dark);"
        ></textarea>
      </div>

      <button type="submit" id="submit-btn" class="btn-primary-on-dark w-full justify-center">
        Send message
      </button>
    </form>
  </div>
</div>

<!-- Toast -->
<div id="toast" style="
  position: fixed; bottom: 32px; left: 50%;
  transform: translateX(-50%) translateY(100px);
  background-color: #1A1710;
  border: 1px solid #9B7B3A;
  color: #EEE8D5;
  padding: 14px 24px;
  border-radius: 999px;
  font-size: 0.875rem; font-weight: 500;
  display: flex; align-items: center; gap: 10px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease;
  opacity: 0; z-index: 9999; white-space: nowrap;
">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;">
    <circle cx="8" cy="8" r="7" stroke="#9B7B3A" stroke-width="1.5"/>
    <path d="M4.5 8L7 10.5L11.5 6" stroke="#9B7B3A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  Message sent — I'll be in touch soon.
</div>

<script>
  const modal    = document.getElementById('contact-modal') as HTMLElement;
  const inner    = modal.querySelector('div') as HTMLElement;
  const openBtn  = document.getElementById('open-contact-modal');
  const closeBtn = document.getElementById('close-contact-modal');
  const form     = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const toast    = document.getElementById('toast') as HTMLElement;

  function openModal() {
    modal.style.opacity = '1';
    modal.style.pointerEvents = 'auto';
    inner.style.transform = 'translateY(0)';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.opacity = '0';
    modal.style.pointerEvents = 'none';
    inner.style.transform = 'translateY(16px)';
    document.body.style.overflow = '';
  }

  function showToast() {
    toast.style.opacity = '1';
    toast.style.transform = 'translateX(-50%) translateY(0)';
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(-50%) translateY(100px)';
    }, 4000);
  }

  openBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  // Close on backdrop click
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.textContent = 'Sending…';
    submitBtn.setAttribute('disabled', 'true');

    const data = new FormData(form);
    await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data as any).toString(),
    });

    form.reset();
    submitBtn.textContent = 'Send message';
    submitBtn.removeAttribute('disabled');
    closeModal();
    showToast();
  });
</script>
