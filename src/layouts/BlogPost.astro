---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(date);

const { text: readTime } = readingTime(post.body ?? '');
---

<Base title={title} description={description}>

  <!-- Post header — dark -->
  <section style="background-color: var(--color-bg-dark);">
    <div class="max-w-3xl mx-auto px-6 py-20">
      <a href="/blog" class="eyebrow mb-6 inline-block no-underline hover:underline" style="color: var(--color-muted-on-dark);">
        &larr; Blog
      </a>

      <div class="flex flex-wrap gap-2 mb-5">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class="text-xs font-semibold px-3 py-1 rounded-full no-underline hover:opacity-80 transition-opacity"
            style="background-color: rgba(238,232,213,0.1); color: var(--color-text-on-dark);"
          >
            {tag}
          </a>
        ))}
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight mb-6" style="color: var(--color-text-on-dark);">
        {title}
      </h1>

      <div class="flex items-center gap-3 text-sm" style="color: var(--color-muted-on-dark);">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>&middot;</span>
        <span>{readTime}</span>
      </div>
    </div>
  </section>

  <!-- Post body -->
  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="prose">
      <slot />
    </div>

    <footer class="mt-16 pt-8" style="border-top: 1px solid var(--color-border);">
      <a href="/blog" class="btn-secondary text-sm">&larr; Back to all posts</a>
    </footer>
  </article>

</Base>
