---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import readingTime from 'reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);

const { text: readTime } = readingTime(post.body ?? '');
---

<Base title={title} description={description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class="font-sans text-xs px-2 py-1 rounded-full no-underline hover:underline"
            style="background-color: var(--color-border); color: var(--color-muted);"
          >
            #{tag}
          </a>
        ))}
      </div>

      <h1 class="font-sans text-3xl sm:text-4xl font-bold leading-tight mb-4" style="color: var(--color-text);">
        {title}
      </h1>

      <div class="flex items-center gap-3 font-sans text-sm" style="color: var(--color-muted);">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span>&middot;</span>
        <span>{readTime}</span>
      </div>
    </header>

    <div class="prose max-w-none" style="color: var(--color-text);">
      <slot />
    </div>

    <footer class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
      <a href="/blog" class="font-sans text-sm" style="color: var(--color-muted);">
        &larr; Back to all posts
      </a>
    </footer>
  </article>
</Base>
