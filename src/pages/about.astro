---
import Base from '../layouts/Base.astro';
---

<Base
  title="About"
  description="Software Engineering Manager based in Edinburgh with around 20 years in tech, leading engineering teams at Insights."
>

  <!-- Full-bleed hero -->
  <section style="
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: flex-end;
    background-image: url('/images/about-hero.jpg');
    background-size: cover;
    background-position: center 30%;
    overflow: hidden;
  ">
    <!-- Stronger overlay needed — image is bright throughout -->
    <div style="
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(15, 14, 10, 0.35) 0%,
        rgba(15, 14, 10, 0.45) 45%,
        rgba(15, 14, 10, 0.88) 75%,
        rgba(15, 14, 10, 0.97) 100%
      );
    " />
    <div class="relative max-w-5xl mx-auto px-6 pb-20 pt-48 w-full">
      <p class="eyebrow mb-4" style="color: rgba(238,232,213,0.7);">About me</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4 leading-tight" style="color: var(--color-text-on-dark);">
        Engineering manager.<br />Based in Edinburgh.
      </h1>
      <p class="text-base leading-relaxed max-w-lg" style="color: var(--color-muted-on-dark);">
        Around 20 years in tech. Currently leading engineering at Insights.
      </p>
    </div>
  </section>

  <!-- Bio -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Background</p>
      <div class="prose">
        <p>
          I'm a Software Engineering Manager based in Edinburgh with around 20 years in tech,
          currently leading a squad of engineers at
          <a href="https://www.insights.com" target="_blank" rel="noopener noreferrer">Insights</a>,
          a SaaS analytics company.
        </p>
        <p>
          My career has taken me from delivering a £1 million telephony platform for the Scottish
          Government to building and growing engineering teams from the ground up. I care a lot about
          the people side of this job: structured onboarding, genuine coaching, creating the kind of
          team culture where engineers actually want to do their best work.
        </p>
        <p>
          I came into management through the code, so I still speak the language. My background is
          in TypeScript, React, and Node.js, and I've spent enough time in the weeds to know when to
          get hands-on and when to get out of the way.
        </p>
      </div>
    </div>
  </section>

  <!-- Engineering culture — subtle bg -->
  <section style="background-color: var(--color-bg-subtle);">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <div class="max-w-2xl">
        <p class="eyebrow mb-3">How I think about the work</p>
        <div class="prose">
          <p>
            Outside of the day job, I'm interested in how engineering organisations learn and improve.
            I've set up communities of practice, run training programmes, and spent more time than I
            care to admit thinking about how to run a good retrospective.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Outside work -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="max-w-2xl">
      <p class="eyebrow mb-3">Outside of work</p>
      <div class="prose">
        <p>
          When I'm not doing any of that, you'll find me on a snowboard whenever the opportunity
          arises, working my way through guitar (just over two years in and still going), or being
          looked after by my two cats, who have very strong opinions about my work-from-home schedule.
        </p>
      </div>
    </div>
  </section>

  <!-- Get in touch — dark -->
  <section style="background-color: var(--color-bg-dark);">
    <div class="max-w-5xl mx-auto px-6 py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-16">

        <!-- Left: copy + social links -->
        <div>
          <p class="eyebrow mb-4" style="color: var(--color-muted-on-dark);">Get in touch</p>
          <h2 class="text-3xl font-bold mb-6 leading-tight" style="color: var(--color-text-on-dark);">
            Always happy to talk.
          </h2>
          <p class="text-base mb-8" style="color: var(--color-muted-on-dark);">
            Use the form or reach out directly. I'm also on LinkedIn and Strava if those are more your speed.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="https://linkedin.com/in/martin-sparks" target="_blank" rel="noopener noreferrer" class="btn-ghost-on-dark">
              LinkedIn
            </a>
            <a href="https://www.strava.com/athletes/97483812" target="_blank" rel="noopener noreferrer" class="btn-ghost-on-dark">
              Strava
            </a>
          </div>
        </div>

        <!-- Right: contact form (Netlify Forms) -->
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-4"
          id="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="bot-field" />

          <div>
            <label class="block text-xs font-semibold mb-1.5" style="color: var(--color-muted-on-dark); letter-spacing: 0.05em; text-transform: uppercase;">Name</label>
            <input
              type="text" name="name" required
              class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all"
              style="background-color: rgba(238,232,213,0.07); border: 1px solid rgba(238,232,213,0.12); color: var(--color-text-on-dark);"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold mb-1.5" style="color: var(--color-muted-on-dark); letter-spacing: 0.05em; text-transform: uppercase;">Email</label>
            <input
              type="email" name="email" required
              class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all"
              style="background-color: rgba(238,232,213,0.07); border: 1px solid rgba(238,232,213,0.12); color: var(--color-text-on-dark);"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold mb-1.5" style="color: var(--color-muted-on-dark); letter-spacing: 0.05em; text-transform: uppercase;">Message</label>
            <textarea
              name="message" rows="4" required
              class="w-full px-4 py-3 rounded-xl text-sm outline-none transition-all resize-none"
              style="background-color: rgba(238,232,213,0.07); border: 1px solid rgba(238,232,213,0.12); color: var(--color-text-on-dark);"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary-on-dark w-full justify-center">
            Send message
          </button>

          <p id="form-success" class="text-sm text-center hidden" style="color: var(--color-accent);">
            Message sent — I'll be in touch soon.
          </p>
        </form>
      </div>
    </div>
  </section>


</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(data as any).toString(),
    });
    form.reset();
    form.style.display = 'none';
    if (success) success.classList.remove('hidden');
  });
</script>
