---
import Base from '../layouts/Base.astro';

if (import.meta.env.SHOW_NOW_PAGE !== 'true') {
  return Astro.redirect('/');
}

const updated = 'May 2026';
---

<Base
  title="Now"
  description="What Martin Sparks is working on, running, reading, and playing right now."
>

  <!-- Hero -->
  <section style="background-color: var(--color-bg-dark);">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <p class="eyebrow mb-4" style="color: var(--color-muted-on-dark);">Now</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4 leading-tight" style="color: var(--color-text-on-dark);">
        What I'm up to.
      </h1>
      <p class="text-base max-w-lg" style="color: var(--color-muted-on-dark);">
        A snapshot of what's on my plate right now. Last updated {updated}.
        Inspired by <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent);">the Now page movement</a>.
      </p>
    </div>
  </section>

  <!-- Content -->
  <div class="max-w-5xl mx-auto px-6 py-16 space-y-16">

    <!-- Working on -->
    <section class="max-w-2xl">
      <p class="eyebrow mb-4">Working on</p>
      <div class="prose">
        <ul>
          <li><!-- e.g. Leading a team initiative at Insights around X --></li>
          <li><!-- e.g. Planning the jigsaw puzzle game side project --></li>
        </ul>
      </div>
    </section>

    <!-- Running -->
    <section class="max-w-2xl" style="padding-top: 2rem; border-top: 1px solid var(--color-border);">
      <p class="eyebrow mb-4">Running</p>
      <div class="prose">
        <ul>
          <li><!-- e.g. Building base mileage ahead of X race --></li>
          <li><!-- e.g. Current weekly target: X km --></li>
        </ul>
      </div>
    </section>

    <!-- Reading -->
    <section class="max-w-2xl" style="padding-top: 2rem; border-top: 1px solid var(--color-border);">
      <p class="eyebrow mb-4">Reading</p>
      <div class="prose">
        <ul>
          <li><!-- e.g. Book title by Author --></li>
        </ul>
      </div>
    </section>

    <!-- Playing -->
    <section class="max-w-2xl" style="padding-top: 2rem; border-top: 1px solid var(--color-border);">
      <p class="eyebrow mb-4">Playing</p>
      <div class="prose">
        <ul>
          <li><!-- e.g. Working through X on guitar --></li>
        </ul>
      </div>
    </section>

    <!-- Learning -->
    <section class="max-w-2xl" style="padding-top: 2rem; border-top: 1px solid var(--color-border);">
      <p class="eyebrow mb-4">Learning</p>
      <div class="prose">
        <ul>
          <li><!-- e.g. Picking up X outside of work --></li>
        </ul>
      </div>
    </section>

  </div>

</Base>
