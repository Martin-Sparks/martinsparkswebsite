---
import Base from '../layouts/Base.astro';

// Placeholder Strava activities — replace with real embed codes from Strava
const activities = [
  {
    id: 'placeholder-1',
    title: 'Sunday Long Run — Chiltern Hills',
    date: '4 May 2026',
    distance: '22.4 km',
    time: '2h 08m',
    elevation: '380m',
    description: 'Out through the beech woods, up to the ridge, back via the canal path. Legs felt heavy for the first 10k then settled into it.',
    stravaEmbedSrc: null,
  },
  {
    id: 'placeholder-2',
    title: 'Tuesday Tempo — Town Loop',
    date: '29 Apr 2026',
    distance: '10.1 km',
    time: '46m 12s',
    elevation: '95m',
    description: 'Threshold effort for the middle 6k. Heart rate held steady. Good session.',
    stravaEmbedSrc: null,
  },
  {
    id: 'placeholder-3',
    title: 'Parkrun — Riverside',
    date: '26 Apr 2026',
    distance: '5.0 km',
    time: '22m 44s',
    elevation: '18m',
    description: 'First parkrun in a while. Went out too hard, paid for it on the second lap. Still fun.',
    stravaEmbedSrc: null,
  },
];
---

<Base
  title="Run Routes"
  description="Strava activities and favourite running routes from Martin Sparks."
>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-sans text-3xl font-bold mb-2" style="color: var(--color-text);">Run Routes</h1>
    <p class="text-base mb-4" style="color: var(--color-muted);">
      Recent runs and favourite routes. Connected to Strava.
    </p>

    <!-- Strava connect note -->
    <div
      class="flex items-start gap-3 rounded-lg p-4 mb-12 text-sm font-sans"
      style="background-color: var(--color-border); color: var(--color-muted);"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
        <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
      </svg>
      <p>
        Live Strava embeds go here once connected. Below are placeholder activity cards showing the intended layout.
        To embed a real activity: open it on Strava, click &ldquo;Share&rdquo; &rarr; &ldquo;Embed&rdquo;, and paste
        the <code class="text-xs">&lt;iframe&gt;</code> src into this page's activity data.
      </p>
    </div>

    <div class="space-y-10">
      {activities.map((activity) => (
        <article
          class="rounded-xl overflow-hidden"
          style="border: 1px solid var(--color-border);"
        >
          <!-- Activity header -->
          <div class="p-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h2 class="font-sans text-lg font-semibold mb-1" style="color: var(--color-text);">
                  {activity.title}
                </h2>
                <time class="font-sans text-xs" style="color: var(--color-muted);">{activity.date}</time>
              </div>
              <!-- Strava logo badge -->
              <span
                class="font-sans text-xs font-bold px-2 py-1 rounded shrink-0"
                style="background: #FC4C02; color: #fff;"
              >
                Strava
              </span>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-3 gap-4 mb-4">
              {[
                { label: 'Distance', value: activity.distance },
                { label: 'Time', value: activity.time },
                { label: 'Elevation', value: activity.elevation },
              ].map(({ label, value }) => (
                <div>
                  <p class="font-sans text-xs uppercase tracking-wide mb-0.5" style="color: var(--color-muted);">{label}</p>
                  <p class="font-sans text-base font-semibold" style="color: var(--color-text);">{value}</p>
                </div>
              ))}
            </div>

            <p class="text-sm leading-relaxed" style="color: var(--color-muted);">{activity.description}</p>
          </div>

          <!-- Strava embed or placeholder map -->
          {activity.stravaEmbedSrc ? (
            <iframe
              src={activity.stravaEmbedSrc}
              width="100%"
              height="405"
              frameborder="0"
              scrolling="no"
              allowtransparency
              style="border-top: 1px solid var(--color-border);"
              title={`Strava activity: ${activity.title}`}
            />
          ) : (
            <div
              class="flex items-center justify-center h-40 font-sans text-sm"
              style="border-top: 1px solid var(--color-border); background-color: var(--color-border); color: var(--color-muted);"
            >
              Map embed placeholder
            </div>
          )}
        </article>
      ))}
    </div>

    <!-- Link to Strava profile -->
    <div class="mt-12 text-center">
      <a
        href="https://www.strava.com/athletes/martinsparks"
        target="_blank"
        rel="noopener noreferrer"
        class="font-sans text-sm font-medium px-5 py-2.5 rounded-md no-underline inline-block transition-opacity hover:opacity-80"
        style="background: #FC4C02; color: #fff;"
      >
        View all activities on Strava &rarr;
      </a>
    </div>
  </div>
</Base>
