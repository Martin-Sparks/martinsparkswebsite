---
import Base from '../layouts/Base.astro';

async function fetchActivities() {
  const tokenRes = await fetch('https://www.strava.com/oauth/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      client_id: import.meta.env.STRAVA_CLIENT_ID,
      client_secret: import.meta.env.STRAVA_CLIENT_SECRET,
      refresh_token: import.meta.env.STRAVA_REFRESH_TOKEN,
      grant_type: 'refresh_token',
    }),
  });
  const { access_token } = await tokenRes.json();

  const res = await fetch('https://www.strava.com/api/v3/athlete/activities?per_page=10', {
    headers: { Authorization: `Bearer ${access_token}` },
  });
  return res.json() as Promise<StravaActivity[]>;
}

interface StravaActivity {
  id: number;
  name: string;
  distance: number;
  moving_time: number;
  total_elevation_gain: number;
  start_date_local: string;
  type: string;
  sport_type: string;
  map: { summary_polyline: string };
  average_heartrate?: number;
  max_heartrate?: number;
  average_cadence?: number;
  average_speed: number;
}

function decodePolyline(encoded: string): [number, number][] {
  const coords: [number, number][] = [];
  let index = 0, lat = 0, lng = 0;
  while (index < encoded.length) {
    let b: number, shift = 0, result = 0;
    do { b = encoded.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
    lat += (result & 1) ? ~(result >> 1) : result >> 1;
    shift = result = 0;
    do { b = encoded.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
    lng += (result & 1) ? ~(result >> 1) : result >> 1;
    coords.push([lat / 1e5, lng / 1e5]);
  }
  return coords;
}

function formatDistance(m: number) { return `${(m / 1000).toFixed(1)} km`; }
function formatTime(s: number) {
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);
  return h > 0 ? `${h}h ${m.toString().padStart(2, '0')}m` : `${m}m ${(s % 60).toString().padStart(2, '0')}s`;
}
function formatPace(mps: number) {
  const secPerKm = 1000 / mps;
  const m = Math.floor(secPerKm / 60), s = Math.round(secPerKm % 60);
  return `${m}:${s.toString().padStart(2, '0')} /km`;
}
function formatDate(iso: string) {
  return new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));
}

const activities = await fetchActivities();
const runs = activities
  .filter((a) => ['Run', 'TrailRun', 'VirtualRun'].includes(a.type))
  .map((a) => ({
    ...a,
    coords: a.map.summary_polyline ? decodePolyline(a.map.summary_polyline) : [],
  }));
---

<Base
  title="Run Routes"
  description="Recent runs pulled live from Strava, with interactive route maps."
>
  <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

  <!-- Photo hero -->
  <section style="
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    background-image: url('/images/runs.jpg');
    background-size: cover;
    background-position: center 50%;
    overflow: hidden;
  ">
    <div style="
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(15, 14, 10, 0.2) 0%,
        rgba(15, 14, 10, 0.45) 50%,
        rgba(15, 14, 10, 0.92) 100%
      );
    " />
    <div class="relative max-w-6xl mx-auto px-6 pb-16 pt-32 w-full">
      <p class="eyebrow mb-4" style="color: rgba(238,232,213,0.7);">Running</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4" style="color: var(--color-text-on-dark);">Run Routes</h1>
      <p class="text-base max-w-lg" style="color: var(--color-muted-on-dark);">
        Latest {runs.length} runs pulled live from Strava. Route maps, pace, heart rate, and cadence. Updated every build.
      </p>
    </div>
  </section>

  <!-- Activity grid -->
  <div class="max-w-6xl mx-auto px-6 py-14">
    {runs.length === 0 && (
      <p class="text-sm" style="color: var(--color-muted);">No recent runs found.</p>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {runs.map((activity) => {
        const stats = [
          { label: 'Distance', value: formatDistance(activity.distance) },
          { label: 'Time',     value: formatTime(activity.moving_time) },
          { label: 'Pace',     value: formatPace(activity.average_speed) },
          { label: 'Elev',     value: `${Math.round(activity.total_elevation_gain)}m` },
          ...(activity.average_heartrate ? [{ label: 'Avg HR', value: `${Math.round(activity.average_heartrate)} bpm` }] : []),
          ...(activity.average_cadence   ? [{ label: 'Cadence', value: `${Math.round(activity.average_cadence * 2)} spm` }] : []),
        ];

        return (
          <article
            style="
              position: relative;
              min-height: 420px;
              border-radius: 20px;
              overflow: hidden;
              background-color: var(--color-bg-dark);
            "
          >
            <!-- Map fills the full card -->
            {activity.coords.length > 0 ? (
              <div
                class="activity-map"
                data-coords={JSON.stringify(activity.coords)}
                style="position: absolute; inset: 0; width: 100%; height: 100%;"
              />
            ) : (
              <div style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--color-bg-subtle);">
                <span style="font-size: 0.75rem; color: var(--color-muted);">No route data</span>
              </div>
            )}

            <!-- Gradient scrim: transparent top → dark bottom -->
            <div style="
              position: absolute;
              inset: 0;
              pointer-events: none;
              background: linear-gradient(
                to bottom,
                rgba(15, 14, 10, 0.05) 0%,
                rgba(15, 14, 10, 0.15) 40%,
                rgba(15, 14, 10, 0.88) 72%,
                rgba(15, 14, 10, 0.97) 100%
              );
            " />

            <!-- Strava badge — top right -->
            <a
              href={`https://www.strava.com/activities/${activity.id}`}
              target="_blank"
              rel="noopener noreferrer"
              style="
                position: absolute;
                top: 16px;
                right: 16px;
                display: inline-flex;
                align-items: center;
                gap: 4px;
                font-size: 0.7rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                padding: 6px 12px;
                border-radius: 999px;
                text-decoration: none;
                background: rgba(252, 76, 2, 0.85);
                backdrop-filter: blur(8px);
                -webkit-backdrop-filter: blur(8px);
                color: #fff;
                border: 1px solid rgba(252, 76, 2, 0.4);
                transition: opacity 0.15s;
              "
            >
              Strava ↗
            </a>

            <!-- Stats overlay — bottom, glassmorphism -->
            <div style="
              position: absolute;
              bottom: 0;
              left: 0;
              right: 0;
              padding: 20px 22px 22px;
            ">
              <h2 style="
                font-size: 1.05rem;
                font-weight: 700;
                color: var(--color-text-on-dark);
                margin-bottom: 4px;
                line-height: 1.3;
              ">
                {activity.name}
              </h2>
              <time style="
                font-size: 0.72rem;
                color: var(--color-muted-on-dark);
                letter-spacing: 0.02em;
                display: block;
                margin-bottom: 14px;
              ">
                {formatDate(activity.start_date_local)}
              </time>

              <!-- Stats row -->
              <div style="
                display: flex;
                flex-wrap: wrap;
                gap: 0;
                background: rgba(15, 14, 10, 0.55);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-radius: 12px;
                border: 1px solid rgba(238, 232, 213, 0.1);
                overflow: hidden;
              ">
                {stats.map((stat, i) => (
                  <div style="
                    flex: 1;
                    min-width: 70px;
                    padding: 10px 14px;
                    border-right: 1px solid rgba(238, 232, 213, 0.08);
                  ">
                    <p style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted-on-dark); margin-bottom: 3px;">
                      {stat.label}
                    </p>
                    <p style="font-size: 0.9rem; font-weight: 700; color: var(--color-text-on-dark); line-height: 1.2;">
                      {stat.value}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
        href="https://www.strava.com/athletes/97483812"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        style="background-color: #FC4C02;"
      >
        View all on Strava &rarr;
      </a>
    </div>
  </div>
</Base>

<script>
  import L from 'leaflet';

  delete (L.Icon.Default.prototype as any)._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
    iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const el = entry.target as HTMLElement;
      observer.unobserve(el);

      const coords: [number, number][] = JSON.parse(el.dataset.coords!);
      if (coords.length === 0) return;

      const map = L.map(el, { zoomControl: false, dragging: false, scrollWheelZoom: false, attributionControl: false });

      // Always dark tiles — the cards are always dark
      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png', {
        subdomains: 'abcd',
        maxZoom: 19,
      }).addTo(map);

      // Heavier route line so it stands out on the dark map
      const route = L.polyline(coords, { color: '#FC4C02', weight: 4, opacity: 0.95 }).addTo(map);

      // Extra bottom padding so the route sits above the glass stats panel
      map.fitBounds(route.getBounds(), { padding: [24, 24, 140, 24] });

      // Start (hollow) and finish (filled) markers
      L.circleMarker(coords[0], {
        radius: 6, color: '#FC4C02', fillColor: '#fff', fillOpacity: 1, weight: 2,
      }).addTo(map);
      L.circleMarker(coords[coords.length - 1], {
        radius: 6, color: '#FC4C02', fillColor: '#FC4C02', fillOpacity: 1, weight: 2,
      }).addTo(map);
    });
  }, { rootMargin: '200px' });

  document.querySelectorAll('.activity-map').forEach((el) => observer.observe(el));
</script>
