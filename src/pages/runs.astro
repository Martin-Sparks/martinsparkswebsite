---
import Base from '../layouts/Base.astro';

// Refresh access token then fetch latest activities at build time
async function fetchActivities() {
  const tokenRes = await fetch('https://www.strava.com/oauth/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      client_id: import.meta.env.STRAVA_CLIENT_ID,
      client_secret: import.meta.env.STRAVA_CLIENT_SECRET,
      refresh_token: import.meta.env.STRAVA_REFRESH_TOKEN,
      grant_type: 'refresh_token',
    }),
  });
  const { access_token } = await tokenRes.json();

  const res = await fetch('https://www.strava.com/api/v3/athlete/activities?per_page=10', {
    headers: { Authorization: `Bearer ${access_token}` },
  });
  return res.json() as Promise<StravaActivity[]>;
}

interface StravaActivity {
  id: number;
  name: string;
  distance: number;         // metres
  moving_time: number;      // seconds
  total_elevation_gain: number; // metres
  start_date_local: string;
  type: string;
  map: { summary_polyline: string };
}

function formatDistance(m: number) {
  return `${(m / 1000).toFixed(1)} km`;
}

function formatTime(s: number) {
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  return h > 0 ? `${h}h ${m.toString().padStart(2, '0')}m` : `${m}m ${(s % 60).toString().padStart(2, '0')}s`;
}

function formatDate(iso: string) {
  return new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
    .format(new Date(iso));
}

const activities = await fetchActivities();
const runs = activities.filter((a) => ['Run', 'TrailRun', 'VirtualRun'].includes(a.type));
---

<Base
  title="Run Routes"
  description="Recent runs pulled live from Strava."
>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="font-sans text-3xl font-bold mb-2" style="color: var(--color-text);">Run Routes</h1>
    <p class="text-base mb-12" style="color: var(--color-muted);">
      Latest runs from Strava. Updated on every site build.
    </p>

    {runs.length === 0 && (
      <p class="font-sans text-sm" style="color: var(--color-muted);">No recent runs found.</p>
    )}

    <div class="space-y-6">
      {runs.map((activity) => (
        <article
          class="rounded-xl overflow-hidden"
          style="border: 1px solid var(--color-border);"
        >
          <div class="p-6">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <h2 class="font-sans text-lg font-semibold mb-1" style="color: var(--color-text);">
                  {activity.name}
                </h2>
                <time class="font-sans text-xs" style="color: var(--color-muted);">
                  {formatDate(activity.start_date_local)}
                </time>
              </div>
              <a
                href={`https://www.strava.com/activities/${activity.id}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-sans text-xs font-bold px-2 py-1 rounded no-underline shrink-0 hover:opacity-80 transition-opacity"
                style="background: #FC4C02; color: #fff;"
              >
                Strava ↗
              </a>
            </div>

            <div class="grid grid-cols-3 gap-4">
              {[
                { label: 'Distance', value: formatDistance(activity.distance) },
                { label: 'Time', value: formatTime(activity.moving_time) },
                { label: 'Elevation', value: `${Math.round(activity.total_elevation_gain)}m` },
              ].map(({ label, value }) => (
                <div>
                  <p class="font-sans text-xs uppercase tracking-wide mb-0.5" style="color: var(--color-muted);">{label}</p>
                  <p class="font-sans text-base font-semibold" style="color: var(--color-text);">{value}</p>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="https://www.strava.com/athletes/martinsparks"
        target="_blank"
        rel="noopener noreferrer"
        class="font-sans text-sm font-medium px-5 py-2.5 rounded-md no-underline inline-block transition-opacity hover:opacity-80"
        style="background: #FC4C02; color: #fff;"
      >
        View all on Strava &rarr;
      </a>
    </div>
  </div>
</Base>
