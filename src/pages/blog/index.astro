---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rendered = await Promise.all(
  posts.map(async (post) => {
    const { Content } = await render(post);
    const { text: readTime } = readingTime(post.body ?? '');
    return { post, Content, readTime };
  })
);

const formatDate = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="Blog"
  description="Writing on software engineering, running, and building things in public."
>
  <!-- Photo hero -->
  <section style="
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    background-image: url('/images/blog-hero.jpg');
    background-size: cover;
    background-position: center 40%;
    overflow: hidden;
  ">
    <div style="
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(15, 14, 10, 0.3) 0%,
        rgba(15, 14, 10, 0.5) 50%,
        rgba(15, 14, 10, 0.93) 100%
      );
    " />
    <div class="relative max-w-5xl mx-auto px-6 pb-16 pt-40 w-full">
      <p class="eyebrow mb-4" style="color: rgba(238,232,213,0.7);">Writing</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4" style="color: var(--color-text-on-dark);">Blog</h1>
      <p class="text-base max-w-lg" style="color: var(--color-muted-on-dark);">
        On software engineering, running, and building things. {posts.length} posts so far.
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 py-14">

    <!-- Tags -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-12">
        {allTags.map((tag) => (
          <a href={`/blog/tag/${tag}`} class="tag-chip">{tag}</a>
        ))}
      </div>
    )}

    <!-- Post list -->
    <div class="space-y-5">
      {rendered.map(({ post, Content, readTime }, i) => (
        <article
          class="rounded-2xl transition-all"
          style="background-color: var(--color-bg-subtle); border: 1px solid var(--color-border);"
        >
          <!-- Card header -->
          <div class="p-6">
            <div class="sm:flex sm:items-start sm:justify-between gap-6">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {post.data.tags.map((tag) => (
                    <a href={`/blog/tag/${tag}`} class="tag-chip">{tag}</a>
                  ))}
                </div>
                <h2 class="text-xl font-bold leading-snug mb-2">
                  <a
                    href={`/blog/${post.id}`}
                    class="no-underline post-title"
                    style="color: var(--color-text);"
                  >
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-sm leading-relaxed" style="color: var(--color-muted);">
                  {post.data.description}
                </p>
              </div>
              <div class="flex sm:flex-col items-center sm:items-end gap-3 mt-4 sm:mt-0 shrink-0">
                <time class="text-xs font-medium whitespace-nowrap" style="color: var(--color-muted);">
                  {formatDate(post.data.date)}
                </time>
                <span class="text-xs" style="color: var(--color-border);">·</span>
                <span class="text-xs font-medium whitespace-nowrap" style="color: var(--color-muted);">{readTime}</span>
              </div>
            </div>

            <!-- Expand toggle -->
            <button
              class="expand-btn mt-5 flex items-center gap-2 text-xs font-semibold transition-colors"
              style="color: var(--color-accent); background: none; border: none; padding: 0; cursor: pointer;"
              data-index={i}
              aria-expanded="false"
            >
              <span class="expand-label">Read inline</span>
              <svg
                class="expand-chevron"
                width="14" height="14" viewBox="0 0 14 14" fill="none"
                style="transition: transform 0.3s ease; flex-shrink: 0;"
              >
                <path d="M2.5 5L7 9.5L11.5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <!-- Expandable content -->
          <div
            class="expand-content"
            data-index={i}
            style="max-height: 0; overflow: hidden; transition: max-height 0.45s ease;"
          >
            <div
              class="prose px-6 pb-8"
              style="border-top: 1px solid var(--color-border); padding-top: 1.75rem;"
            >
              <Content />
            </div>
            <div class="px-6 pb-6 flex gap-4 items-center" style="border-top: 1px solid var(--color-border);">
              <a
                href={`/blog/${post.id}`}
                class="text-xs font-semibold no-underline hover:underline"
                style="color: var(--color-accent);"
              >
                Open full post &rarr;
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.expand-btn').forEach((btn) => {
    const idx = btn.dataset.index;
    const content = document.querySelector<HTMLElement>(`.expand-content[data-index="${idx}"]`);
    const label = btn.querySelector<HTMLElement>('.expand-label');
    const chevron = btn.querySelector<SVGElement>('.expand-chevron');
    if (!content) return;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        content.style.maxHeight = '0';
        btn.setAttribute('aria-expanded', 'false');
        if (label) label.textContent = 'Read inline';
        if (chevron) chevron.style.transform = 'rotate(0deg)';
      } else {
        content.style.maxHeight = content.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
        if (label) label.textContent = 'Collapse';
        if (chevron) chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
